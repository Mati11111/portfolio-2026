---
import PresentationCard from "@/components/Presentation-card.astro";
import ProfileDescription from "@/layouts/ProfileDescription.astro";
import ExperienceMenu from "@/layouts/RangerMenu.astro";
import BarsMetrics from "@/layouts/BarsMetrics.astro";
import Footer from "@/components/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
---

<BaseLayout lang="es">
    <SpeedInsights slot="head" />
    <main class="flex flex-col gap-y-10 w-full">
        <section
            class="min-h-[95vh] bg-primary w-full flex flex-col items-center justify-center overflow-x-hidden"
        >
            <PresentationCard />
        </section>
        <section
            class="h-[110vh] lg:h-[50vh] flex flex-col items-center justify-center"
        >
            <ProfileDescription />
        </section>
        <section
            class="-mt-20 h-[115vh] lg:h-[80vh] flex flex-col items-center justify-center lg:-mt-30"
        >
            <ExperienceMenu />
        </section>
        <section
            class="-mt-20 h-[60vh] flex flex-col items-center justify-center lg:-mt-20"
        >
            <BarsMetrics />
        </section>
    </main>
    <div class="h-50">
        <footer
            id="footer"
            class="h-full bg-primary w-full flex flex-col items-center justify-center gap-y-10 translate-y-full opacity-0"
        >
            <Footer />
        </footer>
    </div>
</BaseLayout>
